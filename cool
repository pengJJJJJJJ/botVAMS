#!/bin/bash
#
# cool - 快速编译脚本
#
# 用法:
#   ./cool        - 同步文件并编译 SDK
#   ./cool clean  - 删除同步过去的文件并通过 git checkout 恢复原状
#
# 功能:
#   1. 将 botVAMS 目录下修改过的文件同步到上级 SDK 源码目录中
#   2. 只拷贝发生了变化的文件，未变化的文件跳过，节省时间
#   3. 拷贝完成后自动执行 SDK 编译
#
# 编译指令:
#   ./build.sh lunch:rockchip_rk3566_taishanpi_1m_v10_defconfig && ./build.sh
#

set -e

# ============================================================
# 路径定义
# ============================================================
SHADOW_DIR="$(cd "$(dirname "$0")" && pwd)"
TARGET_DIR="$(cd "$SHADOW_DIR/.." && pwd)"

# ============================================================
# 遍历 botVAMS 文件的公共函数
# ============================================================
# 输出格式: 每个文件一行（以 null 分隔，通过 while read 处理）
function shadow_files()
{
    find "$SHADOW_DIR" -type f -not -path "$SHADOW_DIR/.git/*" -print0
}

# 跳过规则: 返回 0 表示应该跳过
function should_skip()
{
    local relative_path="$1"
    case "$relative_path" in
        .git/*)   return 0 ;;
        cool)     return 0 ;;
        README.md) return 0 ;;
    esac
    return 1
}

# ============================================================
# clean: 删除同步的文件并恢复 git 仓库
# ============================================================
function do_clean()
{
    echo "============================================"
    echo "  cool clean - 清理 botVAMS 同步的文件"
    echo "============================================"
    echo "  修改文件目录 : $SHADOW_DIR"
    echo "  目标 SDK 目录 : $TARGET_DIR"
    echo "============================================"
    echo ""

    local deleted_count=0
    local skipped_count=0
    declare -A git_repos_seen

    echo "[1/2] 删除 botVAMS 同步过去的文件..."
    echo ""

    while IFS= read -r -d '' src_file; do
        relative_path="${src_file#$SHADOW_DIR/}"
        dest_file="$TARGET_DIR/$relative_path"

        if should_skip "$relative_path"; then
            continue
        fi

        if [ ! -f "$dest_file" ]; then
            skipped_count=$((skipped_count + 1))
            continue
        fi

        echo "  [删除] $relative_path"
        rm -f "$dest_file"
        deleted_count=$((deleted_count + 1))

        # 记录该文件所属的 git 仓库根目录
        dest_dir="$(dirname "$dest_file")"
        local repo_root=""
        while [ "$dest_dir" != "/" ] && [ "$dest_dir" != "" ]; do
            if [ -d "$dest_dir/.git" ]; then
                repo_root="$dest_dir"
                break
            fi
            dest_dir="$(dirname "$dest_dir")"
        done
        if [ -n "$repo_root" ]; then
            git_repos_seen["$repo_root"]=1
        fi

    done < <(shadow_files)

    echo ""
    echo "  删除完成: $deleted_count 个文件已删除, $skipped_count 个文件本来不存在"
    echo ""

    echo "[2/2] 恢复涉及的 git 仓库..."
    echo ""

    local restored_count=0
    for repo in "${!git_repos_seen[@]}"; do
        echo "  [恢复] $repo"
        (cd "$repo" && git checkout .)
        restored_count=$((restored_count + 1))
    done

    echo ""
    echo "  恢复完成: $restored_count 个 git 仓库已执行 git checkout ."
    echo ""

    echo "============================================"
    echo "cool clean 执行完毕"
    echo "============================================"
}

# ============================================================
# build: 同步文件并编译
# ============================================================
function do_build()
{
    echo "============================================"
    echo "  cool - SDK 编译辅助脚本"
    echo "============================================"
    echo "  修改文件目录 : $SHADOW_DIR"
    echo "  目标 SDK 目录 : $TARGET_DIR"
    echo "============================================"
    echo ""

    # ============================================================
    # 遍历 botVAMS 下所有文件，将修改过的文件拷贝到目标目录
    # ============================================================
    copied_count=0
    skipped_count=0

    echo "[1/3] 检查并同步修改过的文件..."

    while IFS= read -r -d '' src_file; do
        relative_path="${src_file#$SHADOW_DIR/}"
        dest_file="$TARGET_DIR/$relative_path"

        if should_skip "$relative_path"; then
            continue
        fi

        # 确保目标文件的父目录存在，不存在则自动创建
        dest_dir="$(dirname "$dest_file")"
        if [ ! -d "$dest_dir" ]; then
            mkdir -p "$dest_dir"
        fi

        # 如果目标文件不存在，直接拷贝
        if [ ! -f "$dest_file" ]; then
            echo "  [新增] $relative_path (目标文件不存在)"
            cp "$src_file" "$dest_file"
            copied_count=$((copied_count + 1))
            continue
        fi

        # 比较文件内容是否一致，一致则跳过，不一致则拷贝
        if cmp -s "$src_file" "$dest_file"; then
            skipped_count=$((skipped_count + 1))
        else
            echo "  [更新] $relative_path (文件已变化)"
            cp "$src_file" "$dest_file"
            copied_count=$((copied_count + 1))
        fi

    done < <(shadow_files)

    echo ""
    echo "  同步完成: $copied_count 个文件已更新, $skipped_count 个文件未变化已跳过"
    echo ""

    # ============================================================
    # 执行编译
    # ============================================================
    echo "[2/3] 选择编译目标板 (lunch)..."
    echo ""
    cd "$TARGET_DIR"
    ./build.sh lunch:rockchip_rk3566_taishanpi_1m_v10_defconfig

    echo ""
    echo "[3/3] 开始编译 SDK..."
    echo ""
    ./build.sh

    echo ""
    echo "============================================"
    echo "cool 脚本执行完毕"
    echo "============================================"
}

# ============================================================
# 主入口: 根据参数分派
# ============================================================
case "${1:-build}" in
    clean)
        do_clean
        ;;
    build)
        do_build
        ;;
    *)
        echo "用法: $0 [build|clean]"
        echo ""
        echo "  build  - 同步文件并编译 SDK (默认)"
        echo "  clean  - 删除同步的文件并通过 git checkout 恢复原状"
        exit 1
        ;;
esac